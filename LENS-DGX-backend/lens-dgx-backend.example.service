[Unit]
Description=LENS DGX backend: Pub/Sub -> vLLM -> BigQuery pipeline
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=quangnn
WorkingDirectory=/home/quangnn/projects/LENS/dgx-gcp/LENS-DGX-backend
Environment=LENS_DGX_ENV=dev
ExecStart=/home/quangnn/projects/LENS/dgx-gcp/LENS-DGX-backend/.venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
# Give in-flight messages time to finish (BQ insert + ack) on shutdown.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
